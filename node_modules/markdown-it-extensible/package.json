{
  "name": "markdown-it-extensible",
  "version": "1.3.1",
  "description": "A highly extensible, zero-code block container and inline directive engine for markdown-it",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./nesting": {
      "types": "./index.d.ts",
      "require": "./nesting.js",
      "default": "./nesting.js"
    },
    "./css": "./theme/payer-theme.css",
    "./payer-theme.css": "./theme/payer-theme.css"
  },
  "files": [
    "index.js",
    "nesting.js",
    "index.d.ts",
    "theme/payer-theme.css",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "markdown-it",
    "markdown-it-plugin",
    "containers",
    "directives",
    "custom-blocks",
    "inline-directives",
    "extensible-markdown",
    "scholarly-markdown",
    "sanskrit",
    "callouts"
  ],
  "author": "birchville-org",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birchville-org/markdown-it-extensible.git"
  },
  "dependencies": {
    "markdown-it": "^15.0.0",
    "markdown-it-container": "^3.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "vitepress": "^1.6.4"
  }
}
