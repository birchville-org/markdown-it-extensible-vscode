{
  "name": "markdown-it-extensible-vscode",
  "displayName": "Markdown-it Extensible Extension",
  "description": "Configure and render custom markdown container syntax dynamically",
  "version": "1.4.0",
  "publisher": "birchville-org",
  "repository": {
    "type": "git",
    "url": "https://github.com/birchville-org/markdown-it-extensible-vscode.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./dist/index.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "categories": [
    "Snippets",
    "Other"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "markdown",
        "path": "./snippets/markdown.json"
      }
    ],
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/payer-theme.css"
    ],
    "markdown.previewScripts": [
      "./media/setup.js"
    ],
    "configuration": {
      "type": "object",
      "title": "Extensible Markdown Settings",
      "properties": {
        "extensibleMarkdown.blockContainers": {
          "type": "array",
          "markdownDescription": "Custom block containers to support in markdown rendering. For example: `[ { \"name\": \"warning-box\", \"className\": \"alert-red\" } ]`",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The markdown container block name (e.g. 'warning-box' for '::: warning-box')"
              },
              "className": {
                "type": "string",
                "description": "The CSS class to apply to the rendered HTML div"
              }
            },
            "required": [
              "name",
              "className"
            ]
          },
          "default": [
            {
              "name": "grammar-box",
              "className": "grammar-box"
            },
            {
              "name": "grammarbox",
              "className": "grammar-box"
            },
            {
              "name": "warning-box",
              "className": "warning-box"
            },
            {
              "name": "warningbox",
              "className": "warning-box"
            },
            {
              "name": "verse-box",
              "className": "verse-box"
            },
            {
              "name": "versebox",
              "className": "verse-box"
            },
            {
              "name": "note-box",
              "className": "note-box"
            },
            {
              "name": "notebox",
              "className": "note-box"
            },
            {
              "name": "indent",
              "className": "indent"
            },
            {
              "name": "media",
              "className": "media"
            },
            {
              "name": "no-header",
              "className": "no-header"
            },
            {
              "name": "noheader",
              "className": "no-header"
            },
            {
              "name": "important",
              "className": "warning-box"
            },
            {
              "name": "literatur-box",
              "className": "note-box"
            },
            {
              "name": "literatur",
              "className": "note-box"
            },
            {
              "name": "compact",
              "className": "verse-box"
            },
            {
              "name": "metrik-schema",
              "className": "metrik-schema"
            },
            {
              "name": "metrikschema",
              "className": "metrik-schema"
            },
            {
              "name": "center",
              "className": "center"
            },
            {
              "name": "laut-table",
              "className": "laut-table"
            },
            {
              "name": "lauttable",
              "className": "laut-table"
            },
            {
              "name": "deleteme-box",
              "className": "deleteme-box"
            },
            {
              "name": "deletemebox",
              "className": "deleteme-box"
            }
          ]
        },
        "extensibleMarkdown.inlineDirectives": {
          "type": "array",
          "markdownDescription": "Custom inline directives to support in markdown rendering. For example: `[ { \"name\": \"mark\", \"className\": \"marker-yellow\", \"tag\": \"mark\" } ]`",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The directive name (e.g. 'mark' for ':mark[text]')"
              },
              "className": {
                "type": "string",
                "description": "The CSS class to apply to the rendered HTML tag"
              },
              "tag": {
                "type": "string",
                "description": "The HTML tag to render (defaults to 'span', e.g. 'mark', 'strong')"
              }
            },
            "required": [
              "name"
            ]
          },
          "default": [
            {
              "name": "sig",
              "className": "signalrot",
              "tag": "strong"
            },
            {
              "name": "mark",
              "className": "marker-yellow",
              "tag": "mark"
            }
          ]
        }
      }
    },
    "configurationDefaults": {
      "[markdown]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Custom block containers and inline directives configured in untrusted workspace settings are restricted to prevent injection.",
      "restrictedConfigurations": [
        "extensibleMarkdown.blockContainers",
        "extensibleMarkdown.inlineDirectives"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "markdown-it-extensible": "^1.4.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/index.js --bundle --outfile=dist/index.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/index.js --bundle --outfile=dist/index.js --external:vscode --format=cjs --platform=node --watch"
  },
  "icon": "icon.png",
  "homepage": "https://birchville-org.github.io/markdown-it-extensible/"
}
